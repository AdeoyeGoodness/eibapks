# Copy to .env and fill in. Never commit the real .env.

# Long random shared secret required to upload. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_SECRET=

# Where the served .apk files live. nginx serves this same directory at /apks/.
APK_DIR=/var/www/eibapks/apks

# Bind address / port (nginx proxies /api/ here).
HOST=127.0.0.1
PORT=8090

# Guardrails
MAX_UPLOAD_BYTES=314572800
KEEP_BACKUPS=5
